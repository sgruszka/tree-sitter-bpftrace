#!/usr/bin/env python3

from pathlib import Path
import subprocess


def main():
    root = Path(__file__).resolve().parents[1]
    scripts = sorted(path for path in (root / "test/upstream/scripts").glob("*.bt")
                     if path.is_file())
    if not scripts:
        print("No upstream .bt scripts found.")
        return 1

    passed = failed = 0
    for script in scripts:
        result = subprocess.run(
            ["tree-sitter", "parse", "-q", str(script)],
            cwd=root,
            stdout=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode == 0:
            passed += 1
            print(f"{script.name}: \033[32mOK\033[0m", flush=True)
        else:
            failed += 1
            print(f"{script.name}: \033[31mFAIL\033[0m", flush=True)

    print(f"\nPassed: {passed}\nFailed: {failed}\nTotal:  {passed + failed}")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
